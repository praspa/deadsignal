; Engine configuration file.
config_version=5

[application]

config/name="Dead Signal"
config/description="Grimdark sci-fi action RPG vertical slice."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

Events="*res://scripts/autoload/events.gd"
InputSetup="*res://scripts/autoload/input_setup.gd"
ItemDB="*res://scripts/autoload/item_db.gd"
GameState="*res://scripts/autoload/game_state.gd"
Audio="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.025, 1)
2d/snap/snap_2d_transforms_to_pixel=false
2d/shadow_atlas/size=1024
